# Folder the screenshots and comparisons folders are written to (default: this project folder)
DIFF_OUTPUT_DIR="D:/temp/playright-diff-output"
# Where the -mrp.json files are read from; mrp-and-quote's fetch is run with OUTPUT_DIR set to it
MRP_AND_QUOTE_OUTPUT_DIR="D:/Temp/mrp-and-quote-output"
MRP_AND_QUOTE_PROJECT_DIR="${REPO_BASE_PATH}/GoPackages/internal/mrp-and-quote"
QUOTE_JOURNEY_NHI_QUOTE_PAGE_URL_TEMPLATE="https://quotes-feature-dev.homeprotect.co.uk/quotesummary#guid={artemisQuoteGuid}&callmediauser=${USERNAME}&bid=1066"
QUOTE_JOURNEY_NHI_UNSAVED_URL_TEMPLATE="https://quotes-feature-dev.homeprotect.co.uk/#guid={artemisQuoteGuid},nhi=false"
QUOTE_JOURNEY_TCAS_QUOTE_PAGE_URL_TEMPLATE="https://quotes-feature-dev.homeprotect.co.uk/landing?policyDetailsId={policyDetailsId}&historyId={historyId}&source=tcas&callmediauser=${USERNAME}"
# TCAS Quote Summary (GUID) entry point, as listed by /api/developer/links
QUOTE_JOURNEY_TCAS_REPLACEMENT_URL_TEMPLATE="https://quotes-feature-dev.homeprotect.co.uk/quotesummary#guid={artemisQuoteGuid}&source=tcas&callmediauser=${USERNAME}&bid=1066"
# Step timeout for each NHI/TCAS capture in quote-page(s), e.g. 45s or 1m; quote loading screens get twice as long (default 30s)
QUOTE_PAGE_TIMEOUT=45s
QUOTE_GUID_LIST_PATH="${REPO_BASE_PATH}/GoPackages/internal/mrp-and-quote/testdata/quoteGuids.txt"
QUOTE_JOURNEY_QUOTE_GUID_URL="https://quotes-feature-dev.homeprotect.co.uk/api/nhi/quote-guid"
QUOTE_JOURNEY_AGENT_ID="${USERNAME}"
QUOTE_JOURNEY_BRANCH_CODE=1066
QUOTE_JOURNEY_CALL_MEDIA_USER="${USERNAME}"
