# Names the comparison's region crops end with, region-N-<name>.png (default before and after)
COMPARE_AFTER_NAME=mrp
COMPARE_BEFORE_NAME=nhi
# mrp-and-quote project the MRP fetch runs in; needed only when -mrp.json files are missing (else use --no-fetch)
MRP_AND_QUOTE_PROJECT_DIR="${REPO_BASE_PATH}/GoPackages/internal/mrp-and-quote"
# Base output folder, outside this project: each environment's results, quote GUID mapping and -mrp.json files
# (mrp-and-quote/, where mrp-and-quote's fetch saves them) are kept in its <QUOTE_JOURNEY_ENVIRONMENT> subfolder.
# This value wins over an OUTPUT_DIR set in the shell, which mrp-and-quote reads for its own output
OUTPUT_DIR="D:/temp/playright-diff-output"
QUOTE_GUID_LIST_PATH="${MRP_AND_QUOTE_PROJECT_DIR}/testdata/quoteGuids.txt"
QUOTE_JOURNEY_AGENT_ID="${USERNAME}"
QUOTE_JOURNEY_BRANCH_CODE=1066
QUOTE_JOURNEY_CALL_MEDIA_USER="${USERNAME}"
# Environment the quote pages and MRP fetch use (dev, tst or stg); Run-Project.ps1 -Environment rewrites it
QUOTE_JOURNEY_ENVIRONMENT=dev
# Quote Journey host, which must refer to the environment; quotes-feature-${QUOTE_JOURNEY_ENVIRONMENT} for feature builds (dev and tst only)
QUOTE_JOURNEY_HOST=quotes-${QUOTE_JOURNEY_ENVIRONMENT}.homeprotect.co.uk
QUOTE_JOURNEY_NHI_QUOTE_PAGE_URL_TEMPLATE="https://${QUOTE_JOURNEY_HOST}/quotesummary#guid={artemisQuoteGuid}&callmediauser=${USERNAME}&bid=1066"
QUOTE_JOURNEY_NHI_UNSAVED_URL_TEMPLATE="https://${QUOTE_JOURNEY_HOST}/#guid={artemisQuoteGuid},nhi=false"
QUOTE_JOURNEY_QUOTE_GUID_URL="https://${QUOTE_JOURNEY_HOST}/api/nhi/quote-guid"
QUOTE_JOURNEY_TCAS_QUOTE_PAGE_URL_TEMPLATE="https://${QUOTE_JOURNEY_HOST}/landing?policyDetailsId={policyDetailsId}&historyId={historyId}&source=tcas&callmediauser=${USERNAME}"
# TCAS Quote Summary (GUID) entry point, as listed by /api/developer/links
QUOTE_JOURNEY_TCAS_REPLACEMENT_URL_TEMPLATE="https://${QUOTE_JOURNEY_HOST}/quotesummary#guid={artemisQuoteGuid}&source=tcas&callmediauser=${USERNAME}&bid=1066"
# Step timeout for each NHI/TCAS capture in quote-page(s), e.g. 45s or 1m; quote loading screens get twice as long (default 30s)
QUOTE_PAGE_TIMEOUT=45s
# Screenshot scale: 1.0 is 100%, 1.5 is 150% (0.5 to 4; default 1.0). Same layout, but text has more pixels, so OCR misreads it less
SCREENSHOT_SCALE=1.5
# VWO (A/B testing) campaign:combination pairs every capture is put in, so NHI and MRP see the same version of the site.
# 49 and 60 are the dev and stg "Agg assumptions URL test"s; 3 opens the quote summary, as before the test
# (their 2 opens "Before you continue" first, where TCAS hangs). A campaign not on the page has no effect
VWO_COMBINATIONS=49:3,60:3
