{
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "crlf",
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "*.ts",
      "options": {
        "endOfLine": "lf"
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "endOfLine": "lf"
      }
    },
    {
      "files": "*.ps1",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.sh",
      "options": {
        "endOfLine": "lf",
        "tabWidth": 4
      }
    },
    {
      "files": "*.yaml",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
